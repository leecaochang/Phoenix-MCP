{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesa-spec.org/schemas/mesa_profile.schema.json",
  "title": "MESA profile document",
  "description": "Canonical machine-readable schema for MESA profiles (MESA Specification v1.1, profile schema_version 1.1). Root document form: semantic_profile with privacy_classification as a sibling key. A document without a semantic_profile key is read as a bare semantic_profile body, the same way mesa-core's parser reads it, so structural checks agree with the runtime validator. Full validation also requires the semantic checks described in $comment.",
  "type": "object",
  "properties": {
    "semantic_profile": {
      "$ref": "#/$defs/semanticProfile"
    },
    "privacy_classification": {
      "$ref": "#/$defs/privacyClassification"
    },
    "diagnostic_profile": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "$comment": "Spec 7: privacy_classification's canonical location is the sibling of semantic_profile. mesa-core's parser reads the nested copy only when the sibling is absent, and ignores it entirely when the sibling exists; a null nested copy reads as absent (default privacy). So the nested copy is validated only in root form with no sibling, and null is permitted there.",
      "if": {
        "required": [
          "semantic_profile"
        ],
        "not": {
          "required": [
            "privacy_classification"
          ]
        }
      },
      "then": {
        "properties": {
          "semantic_profile": {
            "properties": {
              "privacy_classification": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/privacyClassification"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "semanticProfile": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "profile_version": {
          "type": "string"
        },
        "metadata_origin": {
          "$ref": "#/$defs/metadataOrigin"
        },
        "semantic_tags": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "enum": [
                  "assist.always_on",
                  "assist.announcement_capable",
                  "assist.cloud",
                  "assist.local",
                  "assist.satellite",
                  "audio.high_fidelity",
                  "audio.multiroom",
                  "audio.synchronised_playback",
                  "audio.voice_optimised",
                  "automation.climate",
                  "automation.energy_conservation",
                  "automation.lighting",
                  "automation.maintenance",
                  "automation.media",
                  "automation.notification",
                  "automation.presence_response",
                  "automation.schedule_based",
                  "automation.security",
                  "climate.air_quality",
                  "climate.comfort_optimization",
                  "climate.cooling",
                  "climate.energy_optimization",
                  "climate.heating",
                  "climate.humidity_control",
                  "climate.zone_control",
                  "diagnostic.causality",
                  "diagnostic.confidence_scored",
                  "diagnostic.drift_prone",
                  "diagnostic.history_log",
                  "diagnostic.read_only",
                  "energy.battery",
                  "energy.grid_aware",
                  "energy.high_consumption",
                  "energy.monitoring",
                  "energy.solar",
                  "helper.config_parameter",
                  "helper.coordination_signal",
                  "helper.counter_metric",
                  "helper.dashboard_only",
                  "helper.high_impact",
                  "helper.mode_flag",
                  "helper.timer_control",
                  "helper.user_preference",
                  "latency.high",
                  "latency.low",
                  "latency.medium",
                  "lighting.accent",
                  "lighting.ambient",
                  "lighting.circadian",
                  "lighting.colour",
                  "lighting.dimming",
                  "lighting.scene",
                  "lighting.security",
                  "lighting.task",
                  "media.casting",
                  "media.hardware_sync",
                  "media.local_only",
                  "media.lossless",
                  "media.multiroom",
                  "media.voice_control",
                  "person.caregiver",
                  "person.child",
                  "person.guest",
                  "person.primary_resident",
                  "person.secondary_resident",
                  "presence.arrival_departure",
                  "presence.occupancy",
                  "presence.person_identification",
                  "presence.sleep_tracking",
                  "reliability.high",
                  "reliability.poll_dependent",
                  "resource.battery_powered",
                  "resource.cloud_dependent",
                  "resource.grid_aware",
                  "resource.high_power",
                  "resource.local_only",
                  "scene.arrival",
                  "scene.away",
                  "scene.climate",
                  "scene.guest",
                  "scene.lighting",
                  "scene.media",
                  "scene.security",
                  "scene.sleep",
                  "security.access_control",
                  "security.alarm",
                  "security.camera",
                  "security.entry_monitoring",
                  "security.motion_detection",
                  "security.perimeter",
                  "space.entertainment",
                  "space.media",
                  "space.outdoor",
                  "space.sleeping",
                  "space.transition",
                  "space.utility",
                  "space.working",
                  "sync.hardware_precise",
                  "tts.auto_chunking",
                  "tts.expressive_voices",
                  "tts.multilingual",
                  "ui.accessible",
                  "ui.glanceable",
                  "zone.child_associated",
                  "zone.healthcare",
                  "zone.high_sensitivity",
                  "zone.home",
                  "zone.school",
                  "zone.workplace"
                ]
              },
              {
                "type": "string",
                "pattern": "^(?!(?:assist|audio|automation|climate|diagnostic|energy|helper|latency|lighting|media|person|presence|reliability|resource|scene|security|space|sync|tts|ui|zone)\\.)[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
              }
            ]
          }
        },
        "last_updated": {
          "type": "string"
        },
        "inheritance_scope": {
          "enum": [
            "entity",
            "domain",
            "integration",
            "area",
            "device"
          ]
        },
        "capability_semantics": {
          "type": "object",
          "properties": {
            "control_mode": {
              "enum": [
                "autonomous",
                "confirm",
                "read_only",
                "prohibited"
              ]
            }
          }
        },
        "profile_valid_for": {
          "type": "object",
          "properties": {
            "integration_version": {
              "type": "string"
            },
            "ha_version": {
              "type": "string"
            },
            "review_after_days": {
              "type": "number"
            },
            "invalidated_by_entities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "operational_boundaries": {
          "$ref": "#/$defs/operationalBoundaries"
        },
        "person_traits": {
          "$ref": "#/$defs/personTraits"
        },
        "semantic_routing": {
          "type": "object",
          "properties": {
            "intent_tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enhances_domains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "$comment": "privacy_classification is validated at the document root, not here: its canonical location is the sibling of semantic_profile, and a nested copy is read only when the sibling is absent (see the root-level allOf; Spec 7)."
    },
    "personTraits": {
      "type": "object",
      "properties": {
        "household_role": {
          "enum": [
            "primary_resident",
            "secondary_resident",
            "child",
            "regular_guest",
            "temporary_guest",
            "caregiver"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "is_minor": {
          "type": "boolean"
        },
        "associated_zones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "associated_automations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "presence_entity": {
          "type": "string"
        }
      }
    },
    "metadataOrigin": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "developer",
            "user",
            "hybrid",
            "inferred_ai",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "generated_at": {
          "type": "string"
        },
        "staleness_window_days": {
          "type": "number"
        },
        "confirmed_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "$comment": "Inferred Rule 1 (Spec 5.4): an inferred profile must carry its confidence and generation time.",
          "if": {
            "properties": {
              "source": {
                "const": "inferred_ai"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "confidence",
              "generated_at"
            ]
          }
        },
        {
          "$comment": "Spec 5.3: a profile claiming partial human confirmation must say what was confirmed.",
          "if": {
            "properties": {
              "source": {
                "const": "hybrid"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "confirmed_fields"
            ]
          }
        },
        {
          "$comment": "Spec 5.4 Rule 6: confirming a field promotes it to hybrid, so confirmed entries on any other origin are self-contradictory. An empty list confirms nothing and is left alone.",
          "if": {
            "properties": {
              "confirmed_fields": {
                "type": "array",
                "minItems": 1
              }
            },
            "required": [
              "confirmed_fields"
            ]
          },
          "then": {
            "properties": {
              "source": {
                "const": "hybrid"
              }
            },
            "required": [
              "source"
            ]
          }
        }
      ],
      "required": [
        "source"
      ]
    },
    "operationalBoundaries": {
      "type": "object",
      "properties": {
        "control_mode": {
          "enum": [
            "autonomous",
            "confirm",
            "read_only",
            "prohibited"
          ]
        },
        "triggers_automations": {
          "enum": [
            "likely",
            "none",
            "unknown",
            "deployment_defined"
          ]
        },
        "reversible": {
          "type": "boolean"
        },
        "reversibility_cost": {
          "enum": [
            "none",
            "trivial",
            "moderate",
            "high"
          ]
        },
        "reversibility_note": {
          "type": "string"
        },
        "reversibility_window_seconds": {
          "type": "number"
        },
        "idempotent": {
          "type": "boolean"
        },
        "state_persistence": {
          "enum": [
            "permanent",
            "temporary",
            "session",
            "transient"
          ]
        },
        "expected_latency_ms": {
          "type": "number"
        },
        "side_effect_scope": {
          "enum": [
            "entity_only",
            "device_localized",
            "room_localized",
            "zone_wide",
            "deployment_wide"
          ]
        },
        "state_volatility": {
          "enum": [
            "static",
            "low",
            "medium",
            "high",
            "realtime"
          ]
        },
        "enforcement_mode": {
          "enum": [
            "advisory",
            "enforced"
          ]
        },
        "control_reason": {
          "type": "string"
        },
        "human_reason": {
          "type": "string"
        },
        "override_triggers_automations": {
          "type": "boolean"
        },
        "override_control_mode": {
          "type": "boolean"
        },
        "declared_limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declaredLimit"
          }
        },
        "temporal_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/temporalConstraint"
          }
        }
      }
    },
    "privacyClassification": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "public",
            "normal",
            "sensitive",
            "restricted"
          ]
        },
        "deny_response_mode": {
          "enum": [
            "omit",
            "redact",
            "error"
          ]
        },
        "access_roles": {
          "$ref": "#/$defs/accessRoles"
        },
        "contains_presence_data": {
          "type": "boolean"
        },
        "contains_audio_capture": {
          "type": "boolean"
        },
        "contains_visual_capture": {
          "type": "boolean"
        },
        "contains_biometric_data": {
          "type": "boolean"
        },
        "contains_behavioural_data": {
          "type": "boolean"
        },
        "data_retention_local": {
          "type": "boolean"
        },
        "access_logging_recommended": {
          "type": "boolean"
        },
        "privacy_note": {
          "type": "string"
        }
      }
    },
    "accessRoles": {
      "$comment": "Spec 7.2: each entry is an array of role names. A bare string would be read as a set of its characters at enforcement, so 'deny_for: guest' would deny anyone named 'g' and nobody named 'guest'.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unrestricted_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restricted_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "valueConstraint": {
      "$comment": "Spec 6.4: bounds must be numeric. A non-numeric bound is not comparable to the service parameter at enforcement time, so it cannot constrain anything.",
      "properties": {
        "service": {
          "type": "string"
        },
        "parameter": {
          "type": "string"
        },
        "max_value": {
          "type": "number"
        },
        "min_value": {
          "type": "number"
        },
        "permitted_values": {
          "type": "array"
        }
      }
    },
    "predicate": {
      "type": "object",
      "if": {
        "properties": {
          "type": {
            "const": "ha_condition"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "condition"
        ],
        "properties": {
          "condition": {
            "type": "object"
          }
        }
      },
      "else": {
        "required": [
          "entity",
          "operator",
          "value"
        ],
        "properties": {
          "entity": {
            "type": "string"
          },
          "operator": {
            "enum": [
              "eq",
              "neq",
              "gt",
              "gte",
              "lt",
              "lte",
              "in",
              "contains"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operator": {
                  "enum": [
                    "eq",
                    "neq"
                  ]
                }
              },
              "required": [
                "operator"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator": {
                  "enum": [
                    "gt",
                    "gte",
                    "lt",
                    "lte"
                  ]
                }
              },
              "required": [
                "operator"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator": {
                  "enum": [
                    "in"
                  ]
                }
              },
              "required": [
                "operator"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator": {
                  "enum": [
                    "contains"
                  ]
                }
              },
              "required": [
                "operator"
              ]
            },
            "then": {
              "properties": {
                "value": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "declaredLimit": {
      "type": "object",
      "required": [
        "id",
        "predicate",
        "limit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "$ref": "#/$defs/predicate"
        },
        "limit": {
          "allOf": [
            {
              "$ref": "#/$defs/valueConstraint"
            }
          ],
          "type": "object",
          "required": [
            "service",
            "parameter"
          ]
        },
        "human_reason": {
          "type": "string"
        }
      }
    },
    "temporalConstraint": {
      "type": "object",
      "required": [
        "id",
        "condition",
        "effect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "$ref": "#/$defs/temporalCondition"
        },
        "effect": {
          "$ref": "#/$defs/temporalEffect"
        },
        "human_reason": {
          "type": "string"
        }
      }
    },
    "temporalCondition": {
      "$comment": "Spec 6.5: each condition type requires the fields it is evaluated from. An unevaluable constraint is applied as active, so a malformed one costs the author nothing at authoring time unless it is rejected here.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "time_range",
            "day_of_week",
            "calendar_entity",
            "solar_angle",
            "duration",
            "relative_to_event"
          ]
        },
        "negate": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "time_range"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$comment": "Spec 6.5: time_range bounds are 24-hour HH:MM. The evaluator also accepts HH:MM:SS and fails closed on garbage, so a wrong format is only caught by rejecting it here.",
            "required": [
              "start_time",
              "end_time"
            ],
            "properties": {
              "start_time": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "end_time": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "day_of_week"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "days"
            ],
            "properties": {
              "days": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "mon",
                    "tue",
                    "wed",
                    "thu",
                    "fri",
                    "sat",
                    "sun"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "calendar_entity"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "calendar_entity"
            ],
            "properties": {
              "calendar_entity": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "solar_angle"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "solar_event"
            ],
            "properties": {
              "solar_event": {
                "enum": [
                  "sunrise",
                  "sunset",
                  "civil_twilight_start",
                  "civil_twilight_end",
                  "nautical_twilight_start",
                  "nautical_twilight_end"
                ]
              },
              "solar_offset_minutes": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "duration"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "duration_seconds"
            ],
            "properties": {
              "duration_seconds": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "relative_to_event"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "anchor_event",
              "offset_seconds"
            ],
            "properties": {
              "anchor_event": {
                "type": "string"
              },
              "offset_seconds": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "temporalEffect": {
      "allOf": [
        {
          "$ref": "#/$defs/valueConstraint"
        },
        {
          "$comment": "Spec 6.5: a value constraint needs a service to apply to, or it silently constrains nothing.",
          "if": {
            "anyOf": [
              {
                "required": [
                  "max_value"
                ]
              },
              {
                "required": [
                  "min_value"
                ]
              },
              {
                "required": [
                  "permitted_values"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "service"
            ]
          }
        },
        {
          "if": {
            "required": [
              "service"
            ]
          },
          "then": {
            "required": [
              "parameter"
            ]
          }
        },
        {
          "$comment": "Spec 6.5: an effect that declares neither a control_mode nor a value constraint is silently ignored.",
          "anyOf": [
            {
              "required": [
                "control_mode"
              ]
            },
            {
              "required": [
                "max_value"
              ]
            },
            {
              "required": [
                "min_value"
              ]
            },
            {
              "required": [
                "permitted_values"
              ]
            }
          ]
        }
      ],
      "type": "object",
      "minProperties": 1,
      "properties": {
        "control_mode": {
          "enum": [
            "autonomous",
            "confirm",
            "read_only",
            "prohibited"
          ]
        }
      }
    }
  },
  "if": {
    "required": [
      "semantic_profile"
    ]
  },
  "else": {
    "$ref": "#/$defs/semanticProfile"
  },
  "$comment": "Structural validation only: also run semantic validation to reject duplicate IDs within each declared_limits or temporal_constraints array. Cross-layer overrides remain valid."
}
